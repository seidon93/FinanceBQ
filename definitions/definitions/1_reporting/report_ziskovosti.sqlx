config {
  type: "table",
  schema: "finance_data",
  description: "Finální porovnání Plánu vs. Skutečnosti"
}

WITH skutecnost AS (
  -- Sečteme skutečné útraty podle středisek a kategorií
  SELECT
    stredisko,
    kategorie,
    SUM(castka_czk) as skutecnost_total
  FROM ${ref("transakce_skutecnost")}
  GROUP BY 1, 2
),

plan AS (
  -- Vezmeme plán (pro zjednodušení bereme měsíční plán jako srovnávací základ)
  SELECT
    stredisko,
    kategorie,
    plan_mesicne_czk as plan_total
  FROM ${ref("rozpocet_plan")}
)

SELECT
  -- Spojíme to dohromady (FULL OUTER JOIN zajistí, že uvidíme i věci, co nebyly v plánu, ale staly se)
  COALESCE(p.stredisko, s.stredisko) as stredisko,
  COALESCE(p.kategorie, s.kategorie) as kategorie,
  
  -- Čísla
  COALESCE(p.plan_total, 0) as plan_czk,
  COALESCE(s.skutecnost_total, 0) as skutecnost_czk,
  
  -- Výpočet odchylky (Variance)
  (COALESCE(p.plan_total, 0) - COALESCE(s.skutecnost_total, 0)) as rozdil_czk,
  
  -- Grafický ukazatel (Status)
  CASE
    WHEN COALESCE(s.skutecnost_total, 0) > COALESCE(p.plan_total, 0) THEN 'PŘEKROČENO ⚠️'
    WHEN COALESCE(s.skutecnost_total, 0) < COALESCE(p.plan_total, 0) THEN 'ÚSPORA ✅'
    ELSE 'OK'
  END as status

FROM plan p
FULL OUTER JOIN skutecnost s 
  ON p.stredisko = s.stredisko AND p.kategorie = s.kategorie
ORDER BY rozdil_czk ASC
